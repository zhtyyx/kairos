{
  "name": "kairos-pwa",
  "version": "2.0.0",
  "description": "KAIROS 番茄钟 - 纯网页 PWA 版本",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "npm run css:build && vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "css:build": "sass css/main.scss css/main.css --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.97.3",
    "terser": "^5.27.0",
    "vite": "^8.3.0"
  },
  "license": "Apache-2.0",
  "private": true
}
